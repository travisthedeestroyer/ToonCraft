# ToonCraft Kids Studio - Environment Variables

# === Gemini API Keys ===
# Primary API key (used by AI Studio or for single-key setup)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# API Key Pool for rotation (comma-separated)
# These keys will be rotated automatically when rate limits are hit
VITE_GEMINI_API_KEY_1=your_gemini_api_key_1
VITE_GEMINI_API_KEY_2=your_gemini_api_key_2
VITE_GEMINI_API_KEY_3=your_gemini_api_key_3
VITE_GEMINI_API_KEY_4=your_gemini_api_key_4
VITE_GEMINI_API_KEY_5=your_gemini_api_key_5

# === Hugging Face API ===
# Used for video generation fallbacks
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# === Stripe Payment Configuration ===
# Get these from your Stripe Dashboard (https://dashboard.stripe.com)

# Publishable Key (used in client-side code, safe to expose)
VITE_STRIPE_PUBLIC_KEY=pk_live_your_publishable_key_here

# Secret Key (KEEP PRIVATE - only for server-side code)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# Webhook Secret (used to verify Stripe webhook signatures)
# Get this when you create a webhook endpoint in Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Price IDs for different payment packages
# Create these in Stripe Dashboard and link to your products
STRIPE_PRICE_ID_PRO=price_pro_placeholder
STRIPE_PRICE_ID_ULTRA=price_ultra_placeholder

# Product IDs (optional, for reference)
STRIPE_PRODUCT_ID_PRO=prod_pro_placeholder
STRIPE_PRODUCT_ID_ULTRA=prod_ultra_placeholder

# === Supabase Configuration ===
# Database and authentication

VITE_SUPABASE_URL=https://your_supabase_project_url_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# === Application URLs ===
# Used for payment success/cancel redirects
VITE_APP_URL=http://localhost:3000

# For production deployments
VERCEL_URL=tooncraft-studio.vercel.app

# === Development Settings ===
# Set to 'development' or 'production'
NODE_ENV=production

# === Feature Flags ===
# Enable/disable payment features
VITE_PAYMENT_ENABLED=true
VITE_STRIPE_MODE=test  # Set to 'live' for production
